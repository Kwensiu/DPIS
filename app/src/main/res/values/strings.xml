    <string name="help_tutorial_system_title">System mode</string>
    <string name="help_tutorial_system_badge">Native</string>
    <string name="help_tutorial_system_summary">Applies scaling through system-layer hooks for more natural rendering.</string>
    <string name="help_tutorial_system_points">• Needs system-layer Hook\n• Needs target app selection\n• Needs target app support</string>
    <string name="help_tutorial_compat_title">Compat mode</string>
    <string name="help_tutorial_compat_badge">Forced</string>
    <string name="help_tutorial_compat_summary">Uses in-process compatibility hooks to adjust scaling more directly.</string>
    <string name="help_tutorial_compat_points">• Only needs target app selection\n• Customizable text apply routes\n• Prone to layout or scaling glitches</string>
    <string name="help_tutorial_scale_title">Scale mode</string>
    <string name="help_tutorial_scale_badge">Recommended</string>
    <string name="help_tutorial_scale_summary">Adjusts the app by a percentage, useful for quick visual tuning.</string>
    <string name="help_tutorial_scale_points">• Keeps the current width model\n• Best for quick global scaling\n• May need font tuning separately</string>
    <string name="help_tutorial_width_title">Width mode</string>
    <string name="help_tutorial_width_badge">Min width</string>
    <string name="help_tutorial_width_summary">Targets a dp width so layouts behave closer to another screen size.</string>
    <string name="help_tutorial_width_points">• Uses a target dp width\n• Better for layout breakpoint changes\n• Large jumps may move controls around</string>
    <string name="mode_help_title">Mode guide</string>
    <string name="mode_help_subtitle">General adjustment, interface adjustment, and font features are separate choices.</string>
