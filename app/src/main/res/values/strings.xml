    <string name="help_tutorial_font_hooks_title">Custom font hooks</string>
    <string name="help_tutorial_font_hooks_badge">10 routes</string>
    <string name="help_tutorial_font_hooks_summary">Select per-app font scale write points to handle framework-specific font lookup paths.</string>
    <string name="help_tutorial_font_hooks_points">• Resources font: rewrites the font scale baseline read from app Resources.\n• System server font: applies launch-time system Configuration font scale.\n• ActivityThread font: syncs font scale through app binding and configuration dispatch.\n• TextView sp rewrite: intercepts TextView sp size writes for regular native widgets.\n• TextView absolute rewrite: handles TextView sizes already converted to px.\n• TextView current px fallback: compensates from the current TextView px size after later assignments.\n• Paint text size fallback: catches custom-drawn text at the Paint layer.\n• WebView text zoom: adjusts WebView text zoom.\n• Flutter settings: rewrites the textScaleFactor read by the Flutter engine.\n• HyperOS native Flutter: supplements the font path used by HyperOS native Flutter containers.</string>
    <string name="help_tutorial_font_hook_resources_title">Resources font</string>
    <string name="help_tutorial_font_hook_resources_desc">Rewrites the font scale baseline read from app Resources.</string>
    <string name="help_tutorial_font_hook_textview_sp_title">TextView sp rewrite</string>
    <string name="help_tutorial_font_hook_textview_sp_desc">Intercepts TextView sp size writes for regular native widgets.</string>
    <string name="help_tutorial_font_hook_textview_absolute_title">TextView absolute rewrite</string>
    <string name="help_tutorial_font_hook_textview_absolute_desc">Handles TextView sizes already converted to px.</string>
    <string name="help_tutorial_font_hook_textview_current_title">TextView current px fallback</string>
    <string name="help_tutorial_font_hook_textview_current_desc">Compensates from the current TextView px size after later assignments.</string>
    <string name="help_tutorial_font_hook_paint_title">Paint text size fallback</string>
    <string name="help_tutorial_font_hook_paint_desc">Catches custom-drawn text at the Paint layer.</string>
    <string name="help_tutorial_font_hook_webview_title">WebView text zoom</string>
    <string name="help_tutorial_font_hook_webview_desc">Adjusts WebView text zoom.</string>
    <string name="help_tutorial_font_hook_flutter_title">Flutter settings</string>
    <string name="help_tutorial_font_hook_flutter_desc">Rewrites the textScaleFactor read by the Flutter engine.</string>
    <string name="help_tutorial_font_hook_hyperos_title">HyperOS native Flutter</string>
