    <string name="help_tutorial_system_title">系统模式</string>
    <string name="help_tutorial_system_badge">更接近原生</string>
    <string name="help_tutorial_system_summary">通过系统层链路模拟相关参数，显示效果通常更自然。</string>
    <string name="help_tutorial_system_points">• 需勾选 system 作用域\n• 需勾选目标应用\n• 需目标应用支持</string>
    <string name="help_tutorial_compat_title">兼容模式</string>
    <string name="help_tutorial_compat_badge">覆盖更强</string>
    <string name="help_tutorial_compat_summary">通过应用进程内兼容链路直接调整缩放，生效更直接。</string>
    <string name="help_tutorial_compat_points">• 仅需勾选目标应用\n• 可自定义文字生效路径\n• 更容易出现布局错位或缩放异常</string>
    <string name="help_tutorial_scale_title">比例模式</string>
    <string name="help_tutorial_scale_badge">推荐</string>
    <string name="help_tutorial_scale_summary">按百分比调整显示，适合快速微调整体观感。</string>
    <string name="help_tutorial_scale_points">• 保持当前宽度模型\n• 适合快速调整整体缩放\n• 字体可能需要单独微调</string>
    <string name="help_tutorial_width_title">宽度模式</string>
    <string name="help_tutorial_width_badge">宽度</string>
    <string name="help_tutorial_width_summary">按目标 dp 宽度适配，让布局接近另一种屏幕尺寸。</string>
    <string name="help_tutorial_width_points">• 使用目标 dp 宽度\n• 更适合改变布局断点\n• 跨度过大可能移动控件位置</string>
    <string name="mode_help_title">模式说明</string>
    <string name="mode_help_subtitle">通用调整模式、界面调整模式与字体功能是不同层级的选择。</string>
    <string name="mode_help_font_routes_title">通用调整模式</string>
    <string name="mode_help_viewport_types_title">界面调整模式</string>
    <string name="mode_help_font_features_title">字体相关功能</string>
    <string name="help_tutorial_font_hooks_title">自定义字体 Hook</string>
    <string name="help_tutorial_font_hooks_badge">8 条路线</string>
    <string name="help_tutorial_font_hooks_summary">按应用选择字体缩放写入点，用于绕开不同 UI 框架的字体读取差异。</string>
    <string name="help_tutorial_font_hooks_points">• Resources 字体：改写应用从 Resources 读取到的字体缩放基准。\n• TextView sp 改写：拦截 TextView 的 sp 尺寸写入，适合常规原生控件。\n• TextView 绝对值改写：处理已经换算成 px 的 TextView 字号。\n• TextView 当前 px 兜底：在 TextView 当前像素尺寸上做补偿，覆盖更晚的赋值。\n• Paint 文本大小兜底：从 Paint 层兜底处理自绘文字大小。\n• WebView 文本缩放：调整 WebView 文本缩放比例。\n• Flutter settings：改写 Flutter 引擎读取到的 textScaleFactor。\n• HyperOS 原生 Flutter：补充 HyperOS 原生 Flutter 容器的字体链路。</string>
    <string name="help_tutorial_font_hook_resources_title">Resources 字体</string>
    <string name="help_tutorial_font_hook_resources_desc">改写应用从 Resources 读取到的字体缩放基准。</string>
    <string name="help_tutorial_font_hook_textview_sp_title">TextView sp 改写</string>
    <string name="help_tutorial_font_hook_textview_sp_desc">拦截 TextView 的 sp 尺寸写入，适合常规原生控件。</string>
    <string name="help_tutorial_font_hook_textview_absolute_title">TextView 绝对值改写</string>
    <string name="help_tutorial_font_hook_textview_absolute_desc">处理已经换算成 px 的 TextView 字号。</string>
    <string name="help_tutorial_font_hook_textview_current_title">TextView 当前 px 兜底</string>
