<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/quick_template_edit_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingTop="@dimen/main_land_detail_top_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/land_app_detail_padding_horizontal"
            android:paddingEnd="@dimen/land_app_detail_padding_horizontal"
            android:paddingBottom="@dimen/land_app_detail_content_padding_bottom">

            <LinearLayout
                android:id="@+id/template_config_detail_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/land_app_detail_header_min_height"
                android:orientation="horizontal"
                android:paddingTop="@dimen/land_app_detail_header_padding_top"
                android:paddingBottom="@dimen/land_app_detail_header_padding_bottom">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/quick_template_edit_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/quick_template_edit_page_title_new"
                            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                            android:textStyle="bold" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/sheet_unsaved_inline_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="@dimen/land_app_detail_badge_spacing_start"
                            android:translationY="@dimen/template_detail_inline_badge_visual_offset_top"
                            android:background="@drawable/bg_sheet_unsaved_badge"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:minHeight="@dimen/land_app_detail_badge_min_height"
                            android:paddingStart="@dimen/land_app_detail_badge_padding_horizontal"
                            android:paddingTop="@dimen/land_app_detail_badge_padding_vertical"
                            android:paddingEnd="@dimen/land_app_detail_badge_padding_horizontal"
                            android:paddingBottom="@dimen/land_app_detail_badge_padding_vertical"
                            android:text="@string/sheet_unsaved_badge"
                            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:visibility="gone" />
                    </LinearLayout>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/quick_template_edit_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/land_template_detail_subtitle_spacing_top"
                        android:text="@string/quick_template_edit_sheet_subtitle"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/quick_template_edit_reset_button"
                    android:layout_width="@dimen/template_workspace_header_action_button_size"
                    android:layout_height="@dimen/template_workspace_header_action_button_size"
                    android:layout_marginStart="@dimen/template_workspace_header_action_button_spacing"
                    android:background="@drawable/bg_template_workspace_add_button"
                    android:contentDescription="@string/template_workspace_action_reset"
                    android:padding="@dimen/template_workspace_header_action_button_padding"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_reset_settings_24"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/quick_template_edit_delete_button"
                    android:layout_width="@dimen/template_workspace_header_action_button_size"
                    android:layout_height="@dimen/template_workspace_header_action_button_size"
                    android:layout_marginStart="@dimen/template_workspace_header_action_button_spacing"
                    android:background="@drawable/bg_quick_template_delete_button"
                    android:contentDescription="@string/font_library_delete_action"
                    android:padding="@dimen/template_workspace_header_action_button_padding"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_delete_24"
                    app:tint="?attr/colorOnErrorContainer" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/quick_template_edit_name_layout"
                style="@style/Widget.Dpis.TextInputLayout.OutlinedBox.Compact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dialog_app_config_input_row_spacing_top"
                android:hint="@string/quick_template_name_hint"
                app:boxCornerRadiusBottomEnd="@dimen/dialog_app_config_input_corner_radius"
                app:boxCornerRadiusBottomStart="@dimen/dialog_app_config_input_corner_radius"
                app:boxCornerRadiusTopEnd="@dimen/dialog_app_config_input_corner_radius"
                app:boxCornerRadiusTopStart="@dimen/dialog_app_config_input_corner_radius"
                app:endIconMode="clear_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/quick_template_edit_name_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:minHeight="0dp"
                    android:paddingTop="@dimen/dialog_app_config_input_padding_top"
                    android:paddingBottom="@dimen/dialog_app_config_input_padding_bottom" />
            </com.google.android.material.textfield.TextInputLayout>

            <include layout="@layout/view_template_config_sheet_fields" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
