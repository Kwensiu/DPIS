<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/dialog_surface_padding_horizontal"
    android:paddingTop="@dimen/dialog_surface_padding_top"
    android:paddingEnd="@dimen/dialog_surface_padding_horizontal"
    android:paddingBottom="@dimen/dialog_surface_padding_bottom">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/quick_template_sort_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dialog_template_sort_title_inset_start"
        android:includeFontPadding="false"
        android:text="@string/quick_template_sort_title"
        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/quick_template_sort_list"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_template_sort_list_height"
        android:layout_marginTop="@dimen/dialog_body_spacing"
        android:clipToPadding="false" />

    <LinearLayout
        android:id="@+id/quick_template_sort_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_typeface_footer_spacing_top"
        android:gravity="center_vertical|end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/quick_template_sort_cancel_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dialog_typeface_footer_button_height"
            android:minWidth="0dp"
            android:text="@string/dialog_process_action_confirm_negative" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/quick_template_sort_save_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dialog_typeface_footer_button_height"
            android:layout_marginStart="@dimen/dialog_typeface_footer_button_spacing"
            android:minWidth="0dp"
            android:text="@string/quick_template_sort_save" />
    </LinearLayout>
</LinearLayout>
