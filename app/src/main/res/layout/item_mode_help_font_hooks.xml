<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/home_workspace_card_spacing_top"
    android:background="@drawable/bg_mode_help_card"
    android:orientation="vertical"
    android:padding="@dimen/help_tutorial_card_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:text="@string/help_tutorial_font_hooks_title"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_mode_help_badge"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="@dimen/help_tutorial_badge_padding_horizontal"
            android:paddingTop="@dimen/help_tutorial_badge_padding_vertical"
            android:paddingEnd="@dimen/help_tutorial_badge_padding_horizontal"
            android:paddingBottom="@dimen/help_tutorial_badge_padding_vertical"
            android:text="@string/help_tutorial_font_hooks_badge"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/help_tutorial_body_spacing_top"
        android:lineSpacingExtra="@dimen/help_tutorial_text_line_spacing"
        android:text="@string/help_tutorial_font_hooks_summary"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="?attr/colorOnSurface" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/help_tutorial_body_spacing_top"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_mode_help_route_row"
            android:orientation="vertical"
            android:paddingStart="@dimen/help_tutorial_route_row_padding_horizontal"
            android:paddingTop="@dimen/help_tutorial_route_row_padding_vertical"
            android:paddingEnd="@dimen/help_tutorial_route_row_padding_horizontal"
            android:paddingBottom="@dimen/help_tutorial_route_row_padding_vertical">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/help_tutorial_font_hook_resources_title"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_workspace_text_spacing_top"
                android:text="@string/help_tutorial_font_hook_resources_desc"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/help_tutorial_route_row_spacing_top"
            android:background="@drawable/bg_mode_help_route_row"
            android:orientation="vertical"
            android:paddingStart="@dimen/help_tutorial_route_row_padding_horizontal"
            android:paddingTop="@dimen/help_tutorial_route_row_padding_vertical"
            android:paddingEnd="@dimen/help_tutorial_route_row_padding_horizontal"
            android:paddingBottom="@dimen/help_tutorial_route_row_padding_vertical">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/help_tutorial_font_hook_textview_sp_title"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_workspace_text_spacing_top"
                android:text="@string/help_tutorial_font_hook_textview_sp_desc"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/help_tutorial_route_row_spacing_top"
            android:background="@drawable/bg_mode_help_route_row"
            android:orientation="vertical"
            android:paddingStart="@dimen/help_tutorial_route_row_padding_horizontal"
            android:paddingTop="@dimen/help_tutorial_route_row_padding_vertical"
            android:paddingEnd="@dimen/help_tutorial_route_row_padding_horizontal"
            android:paddingBottom="@dimen/help_tutorial_route_row_padding_vertical">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/help_tutorial_font_hook_textview_absolute_title"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_workspace_text_spacing_top"
                android:text="@string/help_tutorial_font_hook_textview_absolute_desc"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/help_tutorial_route_row_spacing_top"
            android:background="@drawable/bg_mode_help_route_row"
            android:orientation="vertical"
            android:paddingStart="@dimen/help_tutorial_route_row_padding_horizontal"
            android:paddingTop="@dimen/help_tutorial_route_row_padding_vertical"
            android:paddingEnd="@dimen/help_tutorial_route_row_padding_horizontal"
            android:paddingBottom="@dimen/help_tutorial_route_row_padding_vertical">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/help_tutorial_font_hook_textview_current_title"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_workspace_text_spacing_top"
                android:text="@string/help_tutorial_font_hook_textview_current_desc"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/help_tutorial_route_row_spacing_top"
            android:background="@drawable/bg_mode_help_route_row"
            android:orientation="vertical"
            android:paddingStart="@dimen/help_tutorial_route_row_padding_horizontal"
            android:paddingTop="@dimen/help_tutorial_route_row_padding_vertical"
            android:paddingEnd="@dimen/help_tutorial_route_row_padding_horizontal"
            android:paddingBottom="@dimen/help_tutorial_route_row_padding_vertical">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/help_tutorial_font_hook_paint_title"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_workspace_text_spacing_top"
                android:text="@string/help_tutorial_font_hook_paint_desc"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/help_tutorial_route_row_spacing_top"
            android:background="@drawable/bg_mode_help_route_row"
            android:orientation="vertical"
            android:paddingStart="@dimen/help_tutorial_route_row_padding_horizontal"
            android:paddingTop="@dimen/help_tutorial_route_row_padding_vertical"
            android:paddingEnd="@dimen/help_tutorial_route_row_padding_horizontal"
            android:paddingBottom="@dimen/help_tutorial_route_row_padding_vertical">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/help_tutorial_font_hook_webview_title"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_workspace_text_spacing_top"
                android:text="@string/help_tutorial_font_hook_webview_desc"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/help_tutorial_route_row_spacing_top"
            android:background="@drawable/bg_mode_help_route_row"
            android:orientation="vertical"
            android:paddingStart="@dimen/help_tutorial_route_row_padding_horizontal"
            android:paddingTop="@dimen/help_tutorial_route_row_padding_vertical"
            android:paddingEnd="@dimen/help_tutorial_route_row_padding_horizontal"
            android:paddingBottom="@dimen/help_tutorial_route_row_padding_vertical">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/help_tutorial_font_hook_flutter_title"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_workspace_text_spacing_top"
                android:text="@string/help_tutorial_font_hook_flutter_desc"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/help_tutorial_route_row_spacing_top"
            android:background="@drawable/bg_mode_help_route_row"
            android:orientation="vertical"
            android:paddingStart="@dimen/help_tutorial_route_row_padding_horizontal"
            android:paddingTop="@dimen/help_tutorial_route_row_padding_vertical"
            android:paddingEnd="@dimen/help_tutorial_route_row_padding_horizontal"
            android:paddingBottom="@dimen/help_tutorial_route_row_padding_vertical">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/help_tutorial_font_hook_hyperos_title"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_workspace_text_spacing_top"
                android:text="@string/help_tutorial_font_hook_hyperos_desc"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
