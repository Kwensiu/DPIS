<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/filter_sheet_padding_horizontal"
        android:paddingTop="@dimen/filter_sheet_padding_vertical"
        android:paddingEnd="@dimen/filter_sheet_padding_horizontal"
        android:paddingBottom="@dimen/filter_sheet_padding_vertical">

        <View
            android:layout_width="@dimen/filter_sheet_drag_handle_width"
            android:layout_height="@dimen/filter_sheet_drag_handle_height"
            android:layout_gravity="center_horizontal"
            android:background="?attr/colorOutlineVariant" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/filter_sheet_title_spacing_top"
            android:text="@string/filter_sheet_title"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/quick_template_targets_filter_show_system_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/filter_sheet_first_switch_spacing_top"
            android:text="@string/filter_show_system_apps"
            app:useMaterialThemeColors="true" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/quick_template_targets_filter_hide_configured_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/filter_sheet_switch_spacing_top"
            android:text="@string/quick_template_targets_filter_hide_configured"
            app:useMaterialThemeColors="true" />
    </LinearLayout>
</ScrollView>
