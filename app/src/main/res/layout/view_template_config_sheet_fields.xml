<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        style="@style/Widget.Dpis.ConfigValueModeRow"
        android:layout_marginTop="@dimen/dialog_app_config_input_row_spacing_top">

        <FrameLayout
            style="@style/Widget.Dpis.ConfigValueInputContainer">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/template_config_viewport_input_layout"
                style="@style/Widget.Dpis.TextInputLayout.OutlinedBox.Compact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/dialog_viewport_hint_scale"
                app:boxCornerRadiusBottomEnd="@dimen/dialog_app_config_input_corner_radius"
                app:boxCornerRadiusBottomStart="@dimen/dialog_app_config_input_corner_radius"
                app:boxCornerRadiusTopEnd="@dimen/dialog_app_config_input_corner_radius"
                app:boxCornerRadiusTopStart="@dimen/dialog_app_config_input_corner_radius"
                app:endIconMode="clear_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/template_config_viewport_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:imeOptions="actionNext"
                    android:inputType="numberDecimal"
                    android:minHeight="0dp"
                    android:paddingTop="@dimen/dialog_app_config_input_padding_top"
                    android:paddingBottom="@dimen/dialog_app_config_input_padding_bottom" />
            </com.google.android.material.textfield.TextInputLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/template_config_viewport_mode_toggle_button"
            style="@style/Widget.Dpis.ConfigValueModeToggleContainer"
            android:contentDescription="@string/dialog_viewport_mode_toggle_description"
            android:clickable="false"
            android:focusable="false">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dialog_mode_toggle_track_height"
                android:layout_marginTop="@dimen/dialog_mode_toggle_content_offset_top"
                android:background="@drawable/bg_mode_toggle_track">

                <View
                    android:id="@+id/template_config_viewport_mode_toggle_thumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_mode_toggle_thumb" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/template_config_viewport_mode_system_label"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/dialog_viewport_mode_system"
                        android:clickable="true"
                        android:focusable="true"
                        android:textAppearance="@style/TextAppearance.Material3.LabelSmall" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/template_config_viewport_mode_compat_label"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/dialog_viewport_mode_compat"
                        android:clickable="true"
                        android:focusable="true"
                        android:textAppearance="@style/TextAppearance.Material3.LabelSmall" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/template_config_viewport_apply_mode_button"
        style="@style/Widget.Dpis.DialogActionButton.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_app_config_selector_spacing_top"
        android:minWidth="0dp"
        android:text="@string/dialog_viewport_apply_strategy_title"
        android:visibility="gone" />

    <LinearLayout
        style="@style/Widget.Dpis.ConfigValueModeRow"
        android:layout_marginTop="@dimen/dialog_app_config_input_row_spacing_top">

        <FrameLayout
            style="@style/Widget.Dpis.ConfigValueInputContainer">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/template_config_font_scale_input_layout"
                style="@style/Widget.Dpis.TextInputLayout.OutlinedBox.Compact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/dialog_font_scale_hint"
                app:boxCornerRadiusBottomEnd="@dimen/dialog_app_config_input_corner_radius"
                app:boxCornerRadiusBottomStart="@dimen/dialog_app_config_input_corner_radius"
                app:boxCornerRadiusTopEnd="@dimen/dialog_app_config_input_corner_radius"
                app:boxCornerRadiusTopStart="@dimen/dialog_app_config_input_corner_radius"
                app:endIconMode="clear_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/template_config_font_scale_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:minHeight="0dp"
                    android:paddingTop="@dimen/dialog_app_config_input_padding_top"
                    android:paddingBottom="@dimen/dialog_app_config_input_padding_bottom" />
            </com.google.android.material.textfield.TextInputLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/template_config_font_mode_toggle_button"
            style="@style/Widget.Dpis.ConfigValueModeToggleContainer"
            android:contentDescription="@string/dialog_font_mode_toggle_description"
            android:clickable="false"
            android:focusable="false">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dialog_mode_toggle_track_height"
                android:layout_marginTop="@dimen/dialog_mode_toggle_content_offset_top"
                android:background="@drawable/bg_mode_toggle_track">

                <View
                    android:id="@+id/template_config_font_mode_toggle_thumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_mode_toggle_thumb" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/template_config_font_mode_system_label"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/dialog_font_mode_system"
                        android:clickable="true"
                        android:focusable="true"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/template_config_font_mode_compat_label"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/dialog_font_mode_compat"
                        android:clickable="true"
                        android:focusable="true"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/template_config_typeface_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_app_config_selector_spacing_top"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:minHeight="@dimen/dialog_mode_toggle_row_min_height"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/template_config_typeface_selector_button"
            style="@style/Widget.Dpis.DialogActionButton.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:maxLines="1"
            android:minWidth="0dp"
            android:paddingStart="@dimen/dialog_app_config_typeface_button_padding_horizontal"
            android:paddingEnd="@dimen/dialog_app_config_typeface_button_padding_horizontal"
            android:text="@string/dialog_typeface_selector_value" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/template_config_font_hook_domains_button"
            style="@style/Widget.Dpis.DialogActionButton.Outlined"
            android:layout_width="@dimen/dialog_mode_toggle_width"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dialog_mode_toggle_spacing_start"
            android:ellipsize="end"
            android:maxLines="1"
            android:minWidth="0dp"
            android:paddingStart="@dimen/dialog_app_config_hook_domains_button_padding_horizontal"
            android:paddingEnd="@dimen/dialog_app_config_hook_domains_button_padding_horizontal"
            android:text="@string/dialog_font_hook_domains_title" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_app_config_save_row_spacing_top"
        android:layout_marginBottom="@dimen/template_config_sheet_save_row_spacing_bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/template_config_reset_button"
            style="@style/Widget.Dpis.DialogActionButton.Outlined.WarnOutline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dialog_action_spacing_between"
            android:minWidth="0dp"
            android:text="@string/template_workspace_action_reset"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/template_config_delete_button"
            style="@style/Widget.Dpis.DialogActionButton.Outlined.WarnOutline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dialog_action_spacing_between"
            android:minWidth="0dp"
            android:text="@string/font_library_delete_action"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/template_config_save_button"
            style="@style/Widget.Dpis.DialogActionButton.Filled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/status_save_button" />
    </LinearLayout>
</merge>
