<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mode_help_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/mode_help_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/home_workspace_padding_horizontal"
        android:paddingTop="@dimen/home_workspace_padding_top"
        android:paddingEnd="@dimen/home_workspace_padding_horizontal"
        android:paddingBottom="@dimen/home_workspace_card_spacing_top">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/mode_help_back_button"
            style="@style/Widget.AppCompat.ImageButton"
            android:layout_width="@dimen/main_search_action_button_size"
            android:layout_height="@dimen/main_search_action_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/system_settings_back"
            android:padding="@dimen/main_search_action_button_padding"
            android:src="@drawable/ic_arrow_back_24"
            android:tint="?attr/colorOnSurface" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/home_workspace_card_spacing_top"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_help_title"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_workspace_text_spacing_top"
                android:text="@string/mode_help_subtitle"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/mode_help_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/home_workspace_padding_horizontal"
        android:paddingEnd="@dimen/home_workspace_padding_horizontal"
        android:paddingBottom="@dimen/home_workspace_padding_bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mode_help_font_routes_title"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <include layout="@layout/item_mode_help_system" />
            <include layout="@layout/item_mode_help_compat" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_workspace_section_spacing_top"
                android:text="@string/mode_help_viewport_types_title"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <include layout="@layout/item_mode_help_scale" />
            <include layout="@layout/item_mode_help_width" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_workspace_section_spacing_top"
                android:text="@string/mode_help_font_features_title"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <include layout="@layout/item_mode_help_font_hooks" />
            <include layout="@layout/item_mode_help_typeface" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
