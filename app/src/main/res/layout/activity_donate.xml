<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/donate_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_toolbar_padding_horizontal"
        android:paddingTop="@dimen/page_toolbar_padding_top"
        android:paddingEnd="@dimen/page_toolbar_padding_horizontal"
        android:paddingBottom="@dimen/page_toolbar_padding_bottom">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/donate_back_button"
            android:layout_width="@dimen/page_back_button_size"
            android:layout_height="@dimen/page_back_button_size"
            android:background="@drawable/bg_round_button_surface"
            android:contentDescription="@string/system_settings_back"
            android:padding="@dimen/page_back_button_padding"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back_24"
            app:tint="?attr/colorOnSurface" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_title_spacing_start"
            android:includeFontPadding="false"
            android:text="@string/donate_title"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineLarge"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/donate_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/donate_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/donate_content_padding_horizontal"
            android:paddingTop="@dimen/donate_content_padding_top"
            android:paddingEnd="@dimen/donate_content_padding_horizontal"
            android:paddingBottom="@dimen/donate_content_padding_bottom">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardCornerRadius="@dimen/page_card_corner_radius"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="@dimen/page_card_stroke_width">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/donate_card_padding">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/donate_message"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/donate_note_spacing_top"
                    android:text="@string/donate_trust_note"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/donate_supporters_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/donate_card_spacing_top"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardCornerRadius="@dimen/page_card_corner_radius"
            app:rippleColor="?attr/colorControlHighlight"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="@dimen/page_card_stroke_width">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/donate_card_padding">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/donate_supporters_title"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textStyle="bold" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/donate_supporters_summary_spacing_top"
                        android:text="@string/donate_supporters_summary"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/donate_supporters_chevron_size"
                    android:layout_height="@dimen/donate_supporters_chevron_size"
                    android:layout_marginStart="@dimen/donate_supporters_chevron_spacing_start"
                    android:src="@drawable/ic_chevron_right_24"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/donate_qr_card_gap"
            android:clipToOutline="true"
            app:cardPreventCornerOverlap="false"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardCornerRadius="@dimen/page_card_corner_radius"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="@dimen/page_card_stroke_width">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/donate_wechat_qr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:background="@android:color/white"
                    android:contentDescription="@string/donate_wechat_qr_description"
                    android:scaleType="fitCenter"
                    android:src="@drawable/donate_wechat" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="@dimen/donate_qr_title_pill_margin"
                    android:background="@drawable/bg_donate_qr_title_pill"
                    android:elevation="@dimen/donate_qr_title_pill_elevation"
                    android:paddingStart="@dimen/donate_qr_title_pill_padding_horizontal"
                    android:paddingTop="@dimen/donate_qr_title_pill_padding_vertical"
                    android:paddingEnd="@dimen/donate_qr_title_pill_padding_horizontal"
                    android:paddingBottom="@dimen/donate_qr_title_pill_padding_vertical"
                    android:text="@string/donate_wechat_title"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/donate_qr_card_gap"
            android:clipToOutline="true"
            app:cardPreventCornerOverlap="false"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardCornerRadius="@dimen/page_card_corner_radius"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="@dimen/page_card_stroke_width">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/donate_alipay_qr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:background="@android:color/white"
                    android:contentDescription="@string/donate_alipay_qr_description"
                    android:scaleType="fitCenter"
                    android:src="@drawable/donate_alipay" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="@dimen/donate_qr_title_pill_margin"
                    android:background="@drawable/bg_donate_qr_title_pill"
                    android:elevation="@dimen/donate_qr_title_pill_elevation"
                    android:paddingStart="@dimen/donate_qr_title_pill_padding_horizontal"
                    android:paddingTop="@dimen/donate_qr_title_pill_padding_vertical"
                    android:paddingEnd="@dimen/donate_qr_title_pill_padding_horizontal"
                    android:paddingBottom="@dimen/donate_qr_title_pill_padding_vertical"
                    android:text="@string/donate_alipay_title"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
