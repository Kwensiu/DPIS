<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/dialog_surface_padding_horizontal"
    android:paddingTop="@dimen/dialog_surface_padding_top"
    android:paddingEnd="@dimen/dialog_surface_padding_horizontal"
    android:paddingBottom="@dimen/dialog_surface_padding_bottom">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/process_action_confirm_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/dialog_process_action_confirm_title"
        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
        android:textStyle="bold" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/process_action_confirm_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_body_spacing"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/dialog_text_line_spacing"
        android:text="@string/dialog_process_action_confirm_message"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/process_action_confirm_proceed_button"
        style="@style/Widget.Dpis.DialogActionButton.Outlined.WarnBg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_action_spacing_top"
        android:text="@string/dialog_process_action_confirm_positive" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/process_action_confirm_cancel_button"
        style="@style/Widget.Dpis.DialogActionButton.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_action_spacing_between"
        android:text="@string/dialog_process_action_confirm_negative" />
</LinearLayout>
