<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dialog_surface_padding_horizontal"
    android:paddingTop="@dimen/dialog_surface_padding_top"
    android:paddingEnd="@dimen/dialog_surface_padding_horizontal"
    android:paddingBottom="@dimen/dialog_surface_padding_bottom"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/typeface_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/dialog_typeface_dialog_title"
        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
        android:textStyle="bold" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/typeface_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_action_spacing_top"
        android:background="@android:color/transparent"
        app:tabBackground="@android:color/transparent"
        app:tabGravity="fill"
        app:tabMode="fixed" />

    <ScrollView
        android:id="@+id/typeface_scroll"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_typeface_list_height"
        android:layout_marginTop="@dimen/dialog_body_spacing">

        <LinearLayout
            android:id="@+id/typeface_options_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/typeface_dialog_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_typeface_footer_spacing_top"
        android:gravity="center_vertical|end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/typeface_dialog_done_button"
            style="@style/Widget.Dpis.DialogActionButton.Filled"
            android:layout_width="0dp"
            android:layout_height="@dimen/dialog_typeface_footer_button_height"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/dialog_typeface_done_action" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/typeface_import_button"
            style="@style/Widget.Dpis.DialogActionButton.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dialog_typeface_footer_button_height"
            android:layout_marginStart="@dimen/dialog_typeface_footer_button_spacing"
            android:minWidth="0dp"
            android:paddingStart="@dimen/dialog_option_button_padding_horizontal"
            android:paddingEnd="@dimen/dialog_option_button_padding_horizontal"
            android:text="@string/dialog_typeface_manage_action" />
    </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
