<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_feedback_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/home_workspace_card_spacing_top"
    android:minHeight="@dimen/home_workspace_status_min_height"
    app:cardBackgroundColor="?attr/colorSurfaceContainer"
    app:cardCornerRadius="@dimen/home_workspace_card_corner_radius"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="@dimen/page_card_stroke_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/home_workspace_card_padding">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_feedback_title"
                android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/home_workspace_text_spacing_top"
                android:text="@string/home_feedback_summary"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/home_workspace_primary_status_text_spacing_start"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_feedback_github_button"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="@dimen/home_feedback_button_size"
                android:layout_height="@dimen/home_feedback_button_size"
                android:contentDescription="@string/home_feedback_github"
                android:minWidth="0dp"
                android:minHeight="0dp"
                app:icon="@drawable/ic_github_24"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:iconTint="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_feedback_qq_button"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="@dimen/home_feedback_button_size"
                android:layout_height="@dimen/home_feedback_button_size"
                android:contentDescription="@string/home_feedback_qq"
                android:minWidth="0dp"
                android:minHeight="0dp"
                app:icon="@drawable/ic_qq_24"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:iconTint="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_feedback_telegram_button"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="@dimen/home_feedback_button_size"
                android:layout_height="@dimen/home_feedback_button_size"
                android:contentDescription="@string/home_feedback_telegram"
                android:minWidth="0dp"
                android:minHeight="0dp"
                app:icon="@drawable/ic_telegram_24"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:iconTint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
