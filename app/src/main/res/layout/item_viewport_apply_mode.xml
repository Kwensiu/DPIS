<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/viewport_apply_mode_row_min_height"
    android:orientation="horizontal"
    android:paddingTop="@dimen/viewport_apply_mode_row_padding_vertical"
    android:paddingBottom="@dimen/viewport_apply_mode_row_padding_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/viewport_apply_mode_text_spacing_end"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/viewport_apply_mode_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/viewport_apply_mode_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/viewport_apply_mode_subtitle_spacing_top"
            android:includeFontPadding="false"
            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <com.google.android.material.radiobutton.MaterialRadioButton
        android:id="@+id/viewport_apply_mode_radio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="?attr/colorPrimary"
        android:minWidth="@dimen/viewport_apply_mode_radio_min_size"
        android:minHeight="@dimen/viewport_apply_mode_radio_min_size"
        android:padding="@dimen/viewport_apply_mode_radio_padding"
        android:saveEnabled="false"
        app:useMaterialThemeColors="true" />
</LinearLayout>
