<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/dialog_app_config_padding_horizontal"
    android:paddingTop="@dimen/dialog_app_config_padding_top"
    android:paddingEnd="@dimen/dialog_app_config_padding_horizontal"
    android:paddingBottom="@dimen/dialog_app_config_padding_bottom">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/feedback_diagnostic_result_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/feedback_diagnostic_result_title"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
        android:textStyle="bold" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/feedback_diagnostic_result_package"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/template_workspace_text_spacing_top"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/feedback_diagnostic_result_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/template_workspace_text_spacing_top"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/feedback_diagnostic_result_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_app_config_header_spacing_top"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textIsSelectable="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/feedback_diagnostic_result_files"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_app_config_header_spacing_top"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/feedback_diagnostic_result_file_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_template_workspace_empty_summary"
            android:orientation="vertical"
            android:paddingStart="@dimen/template_workspace_empty_summary_padding_horizontal"
            android:paddingTop="@dimen/template_workspace_empty_summary_padding_vertical"
            android:paddingEnd="@dimen/template_workspace_empty_summary_padding_horizontal"
            android:paddingBottom="@dimen/template_workspace_empty_summary_padding_vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/feedback_diagnostic_result_file_0_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/feedback_diagnostic_result_file_0_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/template_workspace_text_spacing_top"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/feedback_diagnostic_result_file_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/template_workspace_text_spacing_top"
            android:background="@drawable/bg_template_workspace_empty_summary"
            android:orientation="vertical"
            android:paddingStart="@dimen/template_workspace_empty_summary_padding_horizontal"
            android:paddingTop="@dimen/template_workspace_empty_summary_padding_vertical"
            android:paddingEnd="@dimen/template_workspace_empty_summary_padding_horizontal"
            android:paddingBottom="@dimen/template_workspace_empty_summary_padding_vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/feedback_diagnostic_result_file_1_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/feedback_diagnostic_result_file_1_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/template_workspace_text_spacing_top"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/feedback_diagnostic_result_file_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/template_workspace_text_spacing_top"
            android:background="@drawable/bg_template_workspace_empty_summary"
            android:orientation="vertical"
            android:paddingStart="@dimen/template_workspace_empty_summary_padding_horizontal"
            android:paddingTop="@dimen/template_workspace_empty_summary_padding_vertical"
            android:paddingEnd="@dimen/template_workspace_empty_summary_padding_horizontal"
            android:paddingBottom="@dimen/template_workspace_empty_summary_padding_vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/feedback_diagnostic_result_file_2_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/feedback_diagnostic_result_file_2_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/template_workspace_text_spacing_top"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/feedback_diagnostic_result_privacy_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_app_config_header_spacing_top"
        android:text="@string/feedback_diagnostic_result_privacy_hint"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_app_config_save_row_spacing_top"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/feedback_diagnostic_save_button"
            style="@style/Widget.Dpis.DialogActionButton.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/feedback_diagnostic_save_action" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/feedback_diagnostic_share_button"
            style="@style/Widget.Dpis.DialogActionButton.Filled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dialog_app_config_process_button_spacing_start"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/feedback_diagnostic_share_action" />
    </LinearLayout>
</LinearLayout>
