<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/settings_row_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/settings_row_padding_horizontal"
    android:paddingTop="@dimen/settings_row_padding_vertical"
    android:paddingEnd="@dimen/settings_row_padding_horizontal"
    android:paddingBottom="@dimen/settings_row_padding_vertical">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/setting_icon"
        android:layout_width="@dimen/settings_row_icon_size"
        android:layout_height="@dimen/settings_row_icon_size"
        android:contentDescription="@null"
        app:tint="?attr/colorOnSurfaceVariant" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/settings_row_text_spacing_start"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/setting_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textStyle="bold" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/setting_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/settings_row_subtitle_spacing_top"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/setting_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/settings_row_switch_spacing_start"
        android:saveEnabled="false"
        android:showText="false"
        android:splitTrack="false"
        android:switchMinWidth="56dp"
        android:switchPadding="0dp"
        app:thumbTint="@color/settings_switch_thumb_tint"
        app:trackTint="@color/settings_switch_track_tint"
        app:useMaterialThemeColors="false" />
</LinearLayout>
