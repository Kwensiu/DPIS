<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/global_prefill_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_toolbar_padding_horizontal"
        android:paddingTop="@dimen/page_toolbar_padding_top"
        android:paddingEnd="@dimen/page_toolbar_padding_horizontal"
        android:paddingBottom="@dimen/page_toolbar_padding_bottom">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/global_prefill_back_button"
            android:layout_width="@dimen/page_back_button_size"
            android:layout_height="@dimen/page_back_button_size"
            android:background="@drawable/bg_round_button_surface"
            android:contentDescription="@string/system_settings_back"
            android:padding="@dimen/page_back_button_padding"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back_24" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_title_spacing_start"
            android:includeFontPadding="false"
            android:text="@string/global_prefill_page_title"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineLarge"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/global_prefill_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/global_prefill_content_padding_bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/global_prefill_content_padding_horizontal"
            android:paddingTop="@dimen/global_prefill_content_padding_top"
            android:paddingEnd="@dimen/global_prefill_content_padding_horizontal">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/global_prefill_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="@dimen/dialog_text_line_spacing"
                android:text="@string/global_prefill_page_description"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dialog_app_config_input_row_spacing_top"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:minHeight="@dimen/dialog_mode_toggle_row_min_height"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="@dimen/dialog_mode_toggle_width"
                    android:layout_height="@dimen/dialog_mode_toggle_row_min_height">

                    <LinearLayout
                        android:id="@+id/global_prefill_viewport_mode_toggle_button"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_mode_toggle_track"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="horizontal"
                        android:padding="@dimen/dialog_mode_toggle_content_offset_top">

                        <View
                            android:id="@+id/global_prefill_viewport_mode_toggle_thumb"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_mode_toggle_thumb" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/global_prefill_viewport_mode_system_label"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/dialog_viewport_mode_system"
                            android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/global_prefill_viewport_mode_compat_label"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/dialog_viewport_mode_compat"
                            android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />
                    </LinearLayout>
                </FrameLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/global_prefill_viewport_input_layout"
                    style="@style/Widget.Dpis.TextInputLayout.OutlinedBox.Compact"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dialog_mode_toggle_spacing_start"
                    android:layout_weight="1"
                    android:hint="@string/dialog_viewport_hint_scale"
                    app:boxCornerRadiusBottomEnd="@dimen/dialog_app_config_input_corner_radius"
                    app:boxCornerRadiusBottomStart="@dimen/dialog_app_config_input_corner_radius"
                    app:boxCornerRadiusTopEnd="@dimen/dialog_app_config_input_corner_radius"
                    app:boxCornerRadiusTopStart="@dimen/dialog_app_config_input_corner_radius"
                    app:endIconMode="clear_text">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/global_prefill_viewport_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:minHeight="0dp"
                        android:paddingTop="@dimen/dialog_app_config_input_padding_top"
                        android:paddingBottom="@dimen/dialog_app_config_input_padding_bottom" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dialog_app_config_input_row_spacing_top"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:minHeight="@dimen/dialog_mode_toggle_row_min_height"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="@dimen/dialog_mode_toggle_width"
                    android:layout_height="@dimen/dialog_mode_toggle_row_min_height">

                    <LinearLayout
                        android:id="@+id/global_prefill_font_mode_toggle_button"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_mode_toggle_track"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="horizontal"
                        android:padding="@dimen/dialog_mode_toggle_content_offset_top">

                        <View
                            android:id="@+id/global_prefill_font_mode_toggle_thumb"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_mode_toggle_thumb" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/global_prefill_font_mode_system_label"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/dialog_font_mode_system"
                            android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/global_prefill_font_mode_compat_label"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/dialog_font_mode_compat"
                            android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />
                    </LinearLayout>
                </FrameLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/global_prefill_font_scale_input_layout"
                    style="@style/Widget.Dpis.TextInputLayout.OutlinedBox.Compact"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dialog_mode_toggle_spacing_start"
                    android:layout_weight="1"
                    android:hint="@string/dialog_font_scale_hint"
                    app:boxCornerRadiusBottomEnd="@dimen/dialog_app_config_input_corner_radius"
                    app:boxCornerRadiusBottomStart="@dimen/dialog_app_config_input_corner_radius"
                    app:boxCornerRadiusTopEnd="@dimen/dialog_app_config_input_corner_radius"
                    app:boxCornerRadiusTopStart="@dimen/dialog_app_config_input_corner_radius"
                    app:endIconMode="clear_text">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/global_prefill_font_scale_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:imeOptions="actionDone"
                        android:inputType="number"
                        android:minHeight="0dp"
                        android:paddingTop="@dimen/dialog_app_config_input_padding_top"
                        android:paddingBottom="@dimen/dialog_app_config_input_padding_bottom" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dialog_app_config_selector_spacing_top"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:minHeight="@dimen/dialog_mode_toggle_row_min_height"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/global_prefill_typeface_selector_button"
                    style="@style/Widget.Dpis.DialogActionButton.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="marquee"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingStart="@dimen/dialog_app_config_typeface_button_padding_horizontal"
                    android:paddingEnd="@dimen/dialog_app_config_typeface_button_padding_horizontal"
                    android:text="@string/dialog_typeface_selector_value" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/global_prefill_font_hook_domains_button"
                    style="@style/Widget.Dpis.DialogActionButton.Outlined"
                    android:layout_width="@dimen/dialog_mode_toggle_width"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dialog_mode_toggle_spacing_start"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingStart="@dimen/dialog_app_config_hook_domains_button_padding_horizontal"
                    android:paddingEnd="@dimen/dialog_app_config_hook_domains_button_padding_horizontal"
                    android:text="@string/dialog_font_hook_domains_title" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dialog_app_config_save_row_spacing_top"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/global_prefill_reset_button"
                    style="@style/Widget.Dpis.DialogActionButton.Outlined.WarnOutline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="@string/template_workspace_action_reset" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/global_prefill_save_button"
                    style="@style/Widget.Dpis.DialogActionButton.Filled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dialog_action_spacing_between"
                    android:minWidth="0dp"
                    android:text="@string/status_save_button" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
