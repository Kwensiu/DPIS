<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/dialog_surface_padding_horizontal"
    android:paddingTop="@dimen/dialog_surface_padding_top"
    android:paddingEnd="@dimen/dialog_surface_padding_horizontal"
    android:paddingBottom="@dimen/dialog_surface_padding_bottom">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/startup_disclaimer_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/startup_disclaimer_title"
        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
        android:textStyle="bold" />

    <com.dpis.module.ui.MaxHeightNestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_body_spacing"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbarStyle="insideInset"
        android:scrollbars="vertical"
        app:maxHeightFraction="0.45">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/startup_disclaimer_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="@dimen/dialog_text_line_spacing"
                android:text="@string/startup_disclaimer_message"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </com.dpis.module.ui.MaxHeightNestedScrollView>

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/startup_disclaimer_checkbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_body_spacing"
        android:text="@string/startup_disclaimer_checkbox_text" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/startup_disclaimer_accept_button"
        style="@style/Widget.Dpis.DialogActionButton.Filled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_action_spacing_top"
        android:enabled="false"
        android:text="@string/startup_disclaimer_accept_button" />

</LinearLayout>
