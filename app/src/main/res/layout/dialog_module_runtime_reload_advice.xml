<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/dialog_surface_padding_horizontal"
    android:paddingTop="@dimen/dialog_surface_padding_top"
    android:paddingEnd="@dimen/dialog_surface_padding_horizontal"
    android:paddingBottom="@dimen/dialog_surface_padding_bottom">

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="@dimen/dialog_status_icon_size"
        android:layout_height="@dimen/dialog_status_icon_size"
        android:background="@drawable/bg_round_button_surface"
        android:padding="@dimen/dialog_status_icon_padding"
        android:src="@drawable/ic_error_outline_24"
        app:tint="?attr/colorPrimary" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/module_runtime_reload_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_body_spacing"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/module_runtime_reload_title"
        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
        android:textStyle="bold" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/module_runtime_reload_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_body_spacing"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/dialog_text_line_spacing"
        android:text="@string/module_runtime_reload_message"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/module_runtime_reload_ack_button"
        style="@style/Widget.Dpis.DialogActionButton.Filled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_action_spacing_top"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true"
        android:text="@string/module_runtime_reload_ack_button" />
</LinearLayout>
