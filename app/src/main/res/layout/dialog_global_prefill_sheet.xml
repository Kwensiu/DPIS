<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/global_prefill_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/dialog_app_config_padding_horizontal"
            android:paddingTop="@dimen/dialog_app_config_padding_top"
            android:paddingEnd="@dimen/dialog_app_config_padding_horizontal"
            android:paddingBottom="@dimen/template_config_sheet_padding_bottom">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:minHeight="@dimen/sheet_unsaved_badge_min_height">

                <include layout="@layout/view_sheet_unsaved_badge_handle" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dialog_app_config_header_spacing_top"
                android:gravity="center_vertical"
                android:minHeight="@dimen/dialog_app_config_header_min_height"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/template_workspace_global_prefill_title"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textStyle="bold" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dialog_app_config_package_spacing_top"
                        android:text="@string/template_workspace_global_prefill_subtitle"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/global_prefill_reset_button"
                    android:layout_width="@dimen/template_workspace_header_action_button_size"
                    android:layout_height="@dimen/template_workspace_header_action_button_size"
                    android:layout_marginStart="@dimen/template_workspace_header_action_button_spacing"
                    android:background="@drawable/bg_template_workspace_add_button"
                    android:contentDescription="@string/template_workspace_action_reset"
                    android:padding="@dimen/template_workspace_header_action_button_padding"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_reset_settings_24"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <include layout="@layout/view_template_config_sheet_fields" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
