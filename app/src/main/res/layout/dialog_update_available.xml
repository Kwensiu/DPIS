<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/dialog_surface_padding_horizontal"
    android:paddingTop="@dimen/dialog_surface_padding_top"
    android:paddingEnd="@dimen/dialog_surface_padding_horizontal"
    android:paddingBottom="@dimen/dialog_surface_padding_bottom">

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="@dimen/dialog_status_icon_size"
        android:layout_height="@dimen/dialog_status_icon_size"
        android:background="@drawable/bg_round_button_surface"
        android:padding="@dimen/dialog_status_icon_padding"
        android:src="@drawable/ic_refresh_24"
        app:tint="?attr/colorPrimary" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/update_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/update_dialog_title_spacing_top"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
        android:textStyle="bold" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/update_dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/update_dialog_message_spacing_top"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/dialog_text_line_spacing"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/update_dialog_release_notes_host"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/update_dialog_release_notes_spacing_top">

        <LinearLayout
            android:id="@+id/update_dialog_release_notes_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_update_release_notes_container"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="@dimen/update_dialog_release_notes_padding_horizontal"
            android:paddingTop="@dimen/update_dialog_release_notes_padding_vertical"
            android:paddingEnd="@dimen/update_dialog_release_notes_padding_horizontal"
            android:paddingBottom="@dimen/update_dialog_release_notes_padding_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:singleLine="true"
                android:text="@string/about_update_release_notes_title"
                android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                android:textColor="?attr/colorOnSurface" />

            <com.dpis.module.MaxHeightNestedScrollView
                android:id="@+id/update_dialog_release_notes_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/update_dialog_release_notes_body_spacing_top"
                android:fadeScrollbars="false"
                android:maxHeight="@dimen/update_dialog_release_notes_max_height"
                android:scrollbarStyle="insideInset"
                android:scrollbars="vertical"
                android:visibility="gone">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/update_dialog_release_notes_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="@dimen/dialog_text_line_spacing"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </com.dpis.module.MaxHeightNestedScrollView>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/update_dialog_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/update_dialog_progress_spacing_top"
        android:visibility="gone" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/update_dialog_progress_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/update_dialog_progress_text_spacing_top"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/update_dialog_primary_button"
        style="@style/Widget.Dpis.DialogActionButton.Filled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/update_dialog_primary_button_spacing_top"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/update_dialog_cancel_button"
        style="@style/Widget.Dpis.DialogActionButton.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/update_dialog_cancel_button_spacing_top"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true"
        android:text="@string/about_update_action_cancel_dialog" />
</LinearLayout>
