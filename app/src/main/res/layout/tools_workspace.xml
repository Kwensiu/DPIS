<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tools_workspace_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/tools_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_toolbar_padding_horizontal"
        android:paddingTop="@dimen/page_toolbar_padding_top"
        android:paddingEnd="@dimen/page_toolbar_padding_horizontal"
        android:paddingBottom="@dimen/page_toolbar_padding_bottom">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/workspace_tools"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineLarge"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingStart="@dimen/template_workspace_padding_horizontal"
        android:paddingEnd="@dimen/template_workspace_padding_horizontal"
        android:paddingBottom="@dimen/template_workspace_padding_bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tools_log_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="@dimen/template_workspace_card_corner_radius_compact"
                app:strokeWidth="@dimen/page_card_stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/tools_entry_card_min_height"
                    android:orientation="horizontal"
                    android:padding="@dimen/template_workspace_card_padding">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/tools_entry_icon_size"
                        android:layout_height="@dimen/tools_entry_icon_size"
                        android:padding="@dimen/tools_entry_icon_padding"
                        android:src="@drawable/ic_notes_24"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/tools_entry_text_spacing_start"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/tools_log_title"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/template_workspace_text_spacing_top"
                            android:text="@string/tools_log_subtitle"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/template_workspace_icon_button_size"
                        android:layout_height="@dimen/template_workspace_icon_button_size"
                        android:padding="@dimen/template_workspace_icon_button_padding"
                        android:src="@drawable/ic_chevron_right_24"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/system_font_scale_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/template_workspace_card_spacing_top"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="@dimen/template_workspace_card_corner_radius_compact"
                app:strokeWidth="@dimen/page_card_stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/template_workspace_card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/system_font_scale_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/system_font_scale_title"
                                    android:textAppearance="?attr/textAppearanceTitleMedium"
                                    android:textColor="?attr/colorOnSurface" />

                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/system_font_scale_badge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/template_workspace_chip_spacing_horizontal"
                                    android:background="@drawable/bg_system_font_scale_badge"
                                    android:gravity="center"
                                    android:includeFontPadding="false"
                                    android:paddingStart="@dimen/help_tutorial_badge_padding_horizontal"
                                    android:paddingTop="@dimen/help_tutorial_badge_padding_vertical"
                                    android:paddingEnd="@dimen/help_tutorial_badge_padding_horizontal"
                                    android:paddingBottom="@dimen/help_tutorial_badge_padding_vertical"
                                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textStyle="bold"
                                    android:visibility="gone" />
                            </LinearLayout>

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/system_font_scale_subtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/template_workspace_text_spacing_top"
                                android:text="@string/system_font_scale_subtitle"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                        <androidx.appcompat.widget.AppCompatImageButton
                            android:id="@+id/system_font_scale_apply_button"
                            android:layout_width="@dimen/template_workspace_icon_button_size"
                            android:layout_height="@dimen/template_workspace_icon_button_size"
                            android:layout_marginStart="@dimen/dialog_action_spacing_between"
                            android:background="@drawable/bg_round_button_surface"
                            android:contentDescription="@string/system_font_scale_apply"
                            android:padding="@dimen/template_workspace_icon_button_padding"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_save_24dp"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/system_font_scale_operation_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/template_workspace_actions_spacing_top"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <androidx.appcompat.widget.AppCompatImageButton
                                    android:id="@+id/system_font_scale_decrement_button"
                                    android:layout_width="@dimen/template_workspace_icon_button_size"
                                    android:layout_height="@dimen/template_workspace_icon_button_size"
                                    android:background="@drawable/bg_round_button_surface"
                                    android:contentDescription="@string/system_font_scale_decrement"
                                    android:padding="@dimen/template_workspace_icon_button_padding"
                                    android:scaleType="centerInside"
                                    android:src="@drawable/ic_remove_24"
                                    app:tint="?attr/colorOnSurfaceVariant" />

                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/system_font_scale_pending_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/dialog_action_spacing_between"
                                    android:layout_marginEnd="@dimen/dialog_action_spacing_between"
                                    android:gravity="center"
                                    android:minWidth="@dimen/system_font_scale_value_min_width"
                                    android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textStyle="bold" />

                                <androidx.appcompat.widget.AppCompatImageButton
                                    android:id="@+id/system_font_scale_increment_button"
                                    android:layout_width="@dimen/template_workspace_icon_button_size"
                                    android:layout_height="@dimen/template_workspace_icon_button_size"
                                    android:background="@drawable/bg_round_button_surface"
                                    android:contentDescription="@string/system_font_scale_increment"
                                    android:padding="@dimen/template_workspace_icon_button_padding"
                                    android:scaleType="centerInside"
                                    android:src="@drawable/ic_add_24"
                                    app:tint="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>

                            <com.google.android.material.slider.Slider
                                android:id="@+id/system_font_scale_slider"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/template_workspace_actions_spacing_top"
                                android:stepSize="1"
                                android:valueFrom="50"
                                android:valueTo="200"
                                app:labelBehavior="gone"
                                app:tickVisible="false"
                                app:trackStopIndicatorSize="@dimen/system_font_scale_slider_stop_indicator_size" />

                            <LinearLayout
                                android:id="@+id/system_font_scale_preview"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/template_workspace_actions_spacing_top"
                                android:background="@drawable/bg_template_workspace_empty_summary"
                                android:orientation="vertical"
                                android:padding="@dimen/template_workspace_card_padding">

                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/system_font_scale_preview_title"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/system_font_scale_preview_title"
                                    android:textColor="?attr/colorOnSurface" />

                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/system_font_scale_preview_body"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/template_workspace_text_spacing_top"
                                    android:text="@string/system_font_scale_preview_body"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/system_font_scale_restore_button"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="@dimen/template_workspace_actions_spacing_top"
                                android:minHeight="@dimen/template_workspace_action_button_height"
                                android:minWidth="0dp"
                                android:text="@string/system_font_scale_restore_default" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/system_font_scale_unavailable_overlay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_system_font_scale_overlay"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/template_workspace_card_padding"
                            android:visibility="gone">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="@string/system_font_scale_unavailable_message"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/system_font_scale_permission_overlay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/template_workspace_actions_spacing_top"
                        android:background="@drawable/bg_system_font_scale_permission_panel"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:minHeight="@dimen/system_font_scale_permission_panel_height"
                        android:orientation="vertical"
                        android:padding="@dimen/template_workspace_text_spacing_top"
                        android:visibility="gone">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/system_font_scale_permission_button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/system_font_scale_permission_button"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
