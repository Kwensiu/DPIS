<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/font_detail_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_toolbar_padding_horizontal"
        android:paddingTop="@dimen/page_toolbar_padding_top"
        android:paddingEnd="@dimen/page_toolbar_padding_horizontal"
        android:paddingBottom="@dimen/page_toolbar_padding_bottom">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/font_detail_back_button"
            android:layout_width="@dimen/page_back_button_size"
            android:layout_height="@dimen/page_back_button_size"
            android:background="@drawable/bg_round_button_surface"
            android:contentDescription="@string/system_settings_back"
            android:padding="@dimen/page_back_button_padding"
            android:src="@drawable/ic_arrow_back_24"
            app:tint="?attr/colorOnSurface" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_title_spacing_start"
            android:layout_weight="1"
            android:text="@string/font_library_detail_page_title"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/font_detail_fallback_button"
            style="@style/Widget.Dpis.DialogIconButton.Outlined"
            android:layout_width="@dimen/dialog_feedback_diagnostic_button_size"
            android:layout_height="@dimen/dialog_feedback_diagnostic_button_size"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/font_library_publication_retry_action"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="@dimen/dialog_feedback_diagnostic_button_padding"
            android:visibility="gone"
            app:cornerRadius="@dimen/dialog_feedback_diagnostic_button_corner_radius"
            app:icon="@drawable/ic_build_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/font_detail_rename_button"
            style="@style/Widget.Dpis.DialogIconButton.Outlined"
            android:layout_width="@dimen/dialog_feedback_diagnostic_button_size"
            android:layout_height="@dimen/dialog_feedback_diagnostic_button_size"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/font_library_rename_action"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="@dimen/dialog_feedback_diagnostic_button_padding"
            app:cornerRadius="@dimen/dialog_feedback_diagnostic_button_corner_radius"
            app:icon="@drawable/ic_edit_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/font_detail_delete_button"
            style="@style/Widget.Dpis.DialogIconButton.Outlined"
            android:layout_width="@dimen/dialog_feedback_diagnostic_button_size"
            android:layout_height="@dimen/dialog_feedback_diagnostic_button_size"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/font_library_delete_action"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="@dimen/dialog_feedback_diagnostic_button_padding"
            app:cornerRadius="@dimen/dialog_feedback_diagnostic_button_corner_radius"
            app:icon="@drawable/ic_delete_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/font_detail_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/font_library_list_padding_horizontal"
            android:paddingTop="@dimen/font_library_list_padding_top"
            android:paddingEnd="@dimen/font_library_list_padding_horizontal"
            android:paddingBottom="@dimen/font_library_list_padding_bottom" />
    </ScrollView>
</LinearLayout>
