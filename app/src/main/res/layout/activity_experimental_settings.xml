<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/experimental_settings_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_toolbar_padding_horizontal"
        android:paddingTop="@dimen/page_toolbar_padding_top"
        android:paddingEnd="@dimen/page_toolbar_padding_horizontal"
        android:paddingBottom="@dimen/page_toolbar_padding_bottom">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/experimental_settings_back_button"
            android:layout_width="@dimen/page_back_button_size"
            android:layout_height="@dimen/page_back_button_size"
            android:background="@drawable/bg_round_button_surface"
            android:contentDescription="@string/system_settings_back"
            android:padding="@dimen/page_back_button_padding"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back_24"
            app:tint="?attr/colorOnSurface" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/experimental_settings_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_title_spacing_start"
            android:includeFontPadding="false"
            android:text="@string/settings_experimental_title"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineLarge"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/experimental_settings_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingStart="@dimen/experimental_settings_content_padding_horizontal"
        android:paddingTop="@dimen/experimental_settings_content_padding_top"
        android:paddingEnd="@dimen/experimental_settings_content_padding_horizontal"
        android:paddingBottom="@dimen/experimental_settings_content_padding_bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:cardCornerRadius="@dimen/page_card_corner_radius"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="@dimen/page_card_stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/experimental_ttc_import_row"
                        layout="@layout/item_settings_switch" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
