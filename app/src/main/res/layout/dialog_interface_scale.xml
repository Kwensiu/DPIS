<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/dialog_surface_padding_horizontal"
    android:paddingTop="@dimen/dialog_surface_padding_top"
    android:paddingEnd="@dimen/dialog_surface_padding_horizontal"
    android:paddingBottom="@dimen/dialog_surface_padding_bottom">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/interface_scale_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/settings_interface_scale_dialog_title"
        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/interface_scale_input_layout"
        style="@style/Widget.Dpis.TextInputLayout.OutlinedBox.Compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_action_spacing_top"
        android:hint="@string/settings_interface_scale_input_hint"
        app:boxCornerRadiusBottomEnd="@dimen/dialog_app_config_input_corner_radius"
        app:boxCornerRadiusBottomStart="@dimen/dialog_app_config_input_corner_radius"
        app:boxCornerRadiusTopEnd="@dimen/dialog_app_config_input_corner_radius"
        app:boxCornerRadiusTopStart="@dimen/dialog_app_config_input_corner_radius"
        app:endIconMode="clear_text">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/interface_scale_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:imeOptions="actionDone"
            android:inputType="number"
            android:maxLength="3"
            android:minHeight="0dp"
            android:paddingTop="@dimen/dialog_app_config_input_padding_top"
            android:paddingBottom="@dimen/dialog_app_config_input_padding_bottom"
            android:selectAllOnFocus="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialog_action_spacing_top"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/interface_scale_cancel_button"
            style="@style/Widget.Dpis.DialogActionButton.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/dialog_process_action_confirm_negative" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/interface_scale_save_button"
            style="@style/Widget.Dpis.DialogActionButton.Filled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dialog_action_spacing_between"
            android:layout_weight="1"
            android:text="@string/status_save_button" />
    </LinearLayout>
</LinearLayout>
